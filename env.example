# AnimeciX Desktop — Environment Variables
# Copy this file to .env and fill in your values.
# These are injected at build time by Vite (VITE_ prefix required).

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=https://your-api-domain.com

# CDN domain for video segments and file delivery (hostname only, no protocol)
VITE_CDN_DOMAIN=your-cdn-domain.com

# Main website URL (no trailing slash)
VITE_SITE_URL=https://your-site.com

# Discord application Client ID for Rich Presence (create at https://discord.com/developers)
VITE_DISCORD_CLIENT_ID=your-discord-client-id

# --- Firebase Cloud Messaging (push notifications) ---
# From Firebase console → Project settings → General → "Your apps" → Web app.
#
# Must be the CURRENT app's Firebase project — the one whose service account
# the backend holds as `animecix_next_firebase_key.json` (project id
# `otakucix-ae642`; the app ships under the OtakuciX name temporarily, see
# animecix-js services/firebase-apps.ts). NOT `animecix-171420`, which is the
# retired mobile app. A mismatch means topic subscription and personal pushes
# fail silently, and episode broadcasts never reach the desktop.
#
# Leave these empty to ship a build with push notifications disabled.
VITE_FCM_PROJECT_ID=your-firebase-project-id
VITE_FCM_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FCM_API_KEY=your-firebase-web-api-key
# Project settings → Cloud Messaging → "Sender ID"
VITE_FCM_SENDER_ID=000000000000
# Project settings → Cloud Messaging → Web Push certificates → key pair
VITE_FCM_VAPID_KEY=your-web-push-vapid-public-key